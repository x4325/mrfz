{
  "archetto:MusicHall": {
    "NAME": "音乐厅",
    "DESCRIPTIONS": [
      "空弦在空荡厅里试音。",
      "她校准瞄准。",
      "她记下新旋律。"
    ],
    "OPTIONS": [
      "校准（获得 2 瞄准）",
      "谱曲（抽 2 张牌）"
    ]
  },
  "archetto:BrokenString": {
    "NAME": "断弦",
    "DESCRIPTIONS": [
      "弓弦在高潮前断裂。",
      "她硬拉完一曲，手指流血。",
      "她换备用弦并卖掉旧的。"
    ],
    "OPTIONS": [
      "硬拉（失去 4 生命）",
      "换弦（获得 60 金币）"
    ]
  },
  "archetto:FanMail": {
    "NAME": "粉丝来信",
    "DESCRIPTIONS": [
      "成堆来信堆在后台。",
      "她感到被支持。",
      "她感到被期待。"
    ],
    "OPTIONS": [
      "温暖（最大生命 +3）",
      "压力（获得 3 瞄准）"
    ]
  }
}

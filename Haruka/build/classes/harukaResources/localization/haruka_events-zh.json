{
  "haruka:FestivalGate": {
    "NAME": "祭门",
    "DESCRIPTIONS": [
      "遥站在祭典入口。",
      "花火在胸中点燃。",
      "她在门廊休息。"
    ],
    "OPTIONS": [
      "入场（获得 3 花火）",
      "歇脚（回复 12 生命）"
    ]
  },
  "haruka:FireworkFault": {
    "NAME": "哑火",
    "DESCRIPTIONS": [
      "一批花火受潮。",
      "她徒手试燃，被灼伤。",
      "她把坏货折价卖出。"
    ],
    "OPTIONS": [
      "试燃（失去 6 生命）",
      "折价（获得 65 金币）"
    ]
  },
  "haruka:GrandFinale": {
    "NAME": "大终章",
    "DESCRIPTIONS": [
      "舞台只剩她一人。",
      "她把所有花火压上。",
      "她把体力留给明天。"
    ],
    "OPTIONS": [
      "燃尽（获得 5 花火）",
      "留力（最大生命 +4）"
    ]
  }
}

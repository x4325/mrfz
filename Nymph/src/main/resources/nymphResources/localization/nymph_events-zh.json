{
  "nymph:WhisperShrine": {
    "NAME": "低语神龛",
    "DESCRIPTIONS": [
      "妮芙在神龛前停步。",
      "她抚平自己的心跳。",
      "她在周身布下结界。"
    ],
    "OPTIONS": [
      "平复（回复 8 生命）",
      "结界（获得 10 格挡）"
    ]
  },
  "nymph:MirrorPool": {
    "NAME": "镜池",
    "DESCRIPTIONS": [
      "池面映出无数张脸。",
      "她看见更多可能。",
      "她捞走池边的供品。"
    ],
    "OPTIONS": [
      "凝视（抽 2 张牌）",
      "供品（获得 50 金币）"
    ]
  },
  "nymph:HeartDoor": {
    "NAME": "心门",
    "DESCRIPTIONS": [
      "一扇门只有心跳能打开。",
      "她让门记住自己。",
      "门索取代价。"
    ],
    "OPTIONS": [
      "开门（最大生命 +3）",
      "硬开（失去 5 生命）"
    ]
  }
}
